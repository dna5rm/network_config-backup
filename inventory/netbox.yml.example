---
# NetBox dynamic inventory template for network_config-backup.
#
# ./backup copies this file to a temporary inventory and inserts the optional
# site and platform runner filters in place of the anchor line. Do not run
# this file directly.
#
# The config_backup_netbox plugin reads NETBOX_API and NETBOX_TOKEN from the
# environment; neither value is written into this file.
#
# Membership: the query keeps devices whose status is active and which have
# a primary IPv4. The plugin drops devices with no platform after the
# query, because has_platform is not a filter every NetBox version
# advertises. The platform custom field ansible_network_os is checked by
# the play, before anything connects.

plugin: config_backup_netbox

validate_certs: false
timeout: 180

device_query_filters:
  - status: active
  - has_primary_ip: 'true'
  # anchor: config-backup-runner-filters

# The plugin accepts this option and ignores it: the backup never queries
# virtual machines.
vm_query_filters:
  - name: config-backup-no-virtual-machines
